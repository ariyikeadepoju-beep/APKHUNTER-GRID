# ==========================================
# APK Hunter Grid — Environment Configuration
# ==========================================

# Security & Sessions
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production; SQLite supported for zero-config quickstart)
# Production: postgresql://postgres:postgres@localhost:5432/apkhunter
DATABASE_URL=sqlite:///./apkhunter.db

# Official Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_BOT_TOKEN=your_official_discord_bot_token
DISCORD_REDIRECT_URI=http://localhost:3001/settings/discord/callback
DISCORD_TEST_CHANNEL_ID=your_test_channel_id

# Default Quickstart Operator Credentials
DEFAULT_ADMIN_EMAIL=admin@apkhunter.grid
DEFAULT_ADMIN_PASSWORD=HunterGrid2026!
